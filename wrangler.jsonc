{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arksoft-main",
  "compatibility_date": "2025-07-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "arksoft.xyz", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true
}
